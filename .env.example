# Trace

TRACE_APP_NAME="Trace"
TRACE_ENV=development
TRACE_SECRET_KEY=change-me
TRACE_SESSION_COOKIE=trace_session
TRACE_API_HOST=0.0.0.0
TRACE_API_PORT=8000
TRACE_WEB_PORT=3000
TRACE_WEB_API_URL=http://api:8000
TRACE_POSTGRES_HOST=postgres
TRACE_POSTGRES_PORT=5432
TRACE_POSTGRES_DB=trace
TRACE_POSTGRES_USER=trace
TRACE_POSTGRES_PASSWORD=trace
TRACE_REDIS_URL=redis://redis:6379/0
TRACE_STORAGE_BACKEND=filesystem
TRACE_STORAGE_ROOT=/data/objects
TRACE_MAX_UPLOAD_BYTES=26214400
# Model provider: mock (deterministic, tests) | local (Ollama etc., data stays on this machine)
# | hosted (OpenAI-compatible cloud API; requires TRACE_HOSTED_EGRESS_ACKNOWLEDGED=true)
TRACE_MODEL_PROVIDER=mock
TRACE_MODEL_NAME=qwen2.5:7b-instruct
TRACE_MODEL_BASE_URL=http://host.docker.internal:11434/v1
TRACE_MODEL_API_KEY=
TRACE_MODEL_TIMEOUT_SECONDS=180
TRACE_HOSTED_EGRESS_ACKNOWLEDGED=false
TRACE_OCR_PROVIDER=disabled
TRACE_OCR_BASE_URL=http://ocr:8010
TRACE_EMBEDDING_PROVIDER=hash
TRACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TRACE_ALLOW_INSECURE_DEMO_LOGIN=true
